#!/usr/bin/env ruby

if ARGV[0].nil?
  $stderr.puts "Usage: #{File.basename $0} <autopkgtest_summary_file>"
  exit 1
end

file = ARGV[0]
counter = 1

begin
	output = File.open("#{file}", "r").read
rescue
	$stderr.puts "Error: can't read file #{file}"
	exit 1
end

# One line per test: "<name> <RESULT>[ <details>]", e.g.
#   version              PASS
#   version              PASS (superficial)
#   smoke                SKIP Test needs root on testbed which is not available
#   smoke                FAIL non-zero exit status 1
#   smoke                FAIL status: 1 (autopkgtest < 2.2.3+nmu1)
#   smoke                FLAKY non-zero exit status 1
# Continuation lines ending in ':' are joined with the next one.
results = []
output.gsub(/:\n/, ':').each_line do |line|
	m = /\A(\S+)\s+(PASS|FAIL|SKIP|FLAKY|NEUTRAL)\b\s*(.*?)\s*\z/.match(line)
	next if m.nil?
	test, result, details = m[1], m[2], m[3]
	n = results.length + 1
	results << case result
		when "PASS"
			"ok #{n}           #{test} passed#{details.empty? ? "" : " " + details}"
		when "SKIP"
			"ok #{n}           #{test} # SKIP #{details}"
		when "FLAKY", "NEUTRAL"
			"ok #{n}           #{test} # TODO #{result.downcase}: #{details}"
		else
			status = /non-zero exit status (.*)|status:\s*(.*)/.match(details)
			status ? "not ok #{n}           #{test} - exit status #{status[1] || status[2]}" :
			         "not ok #{n}           #{test} #{details}"
		end
end

if results.empty?
  puts "1..0 # Skipped: no autopkgtest output found"
  exit 0
end

puts "1..#{results.length}"
results.each { |r| puts r }
